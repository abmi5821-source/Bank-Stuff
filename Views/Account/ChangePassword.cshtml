@{ ViewData["Title"] = "تغيير كلمة السر"; }
<h1>تغيير كلمة السر</h1>
<div class="panel" style="max-width:420px">
  @if (ViewBag.Error != null) { <div class="flash bad">@ViewBag.Error</div> }
  <form method="post" class="stack">
    <label>كلمة السر الحالية <input type="password" name="current" required></label>
    <label>كلمة السر الجديدة (8 أحرف على الأقل) <input type="password" name="next" minlength="8" required></label>
    <button class="btn">حفظ التغيير</button>
  </form>
</div>
