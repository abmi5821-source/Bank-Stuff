@model List<Employee>
@{ ViewData["Title"] = "التقارير"; }
<h1>التقارير والرسوم البيانية</h1>
<form method="get" class="filters">
  <label>المنطقة
    <select name="regionId" onchange="this.form.submit()">
      <option value="">كل المناطق</option>
      @foreach (var r in (List<Region>)ViewBag.Regions) { <option value="@r.Id" selected="@((int?)ViewBag.RegionId == r.Id)">@r.Name</option> }
    </select>
  </label>
</form>
<div class="panel">
  <table>
    <tr><th>المنطقة</th><th>الفرع</th><th>الموظف</th><th>الصفة</th><th>عرض</th></tr>
    @foreach (var e in Model)
    {
      <tr>
        <td>@e.Branch.Region.Name</td><td>@e.Branch.Name</td><td>@e.FullName</td><td>@(e.IsPrimary ? "أساسي" : "بديل")</td>
        <td class="row"><a href="/Reports/Employee/@e.Id?period=week">أسبوع</a><a href="/Reports/Employee/@e.Id?period=month">شهر</a><a href="/Reports/Employee/@e.Id?period=season">فصل</a><a href="/Reports/Employee/@e.Id?period=year">سنة</a></td>
      </tr>
    }
  </table>
</div>
